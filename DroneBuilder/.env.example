# Copy this file to .env in the same directory as docker-compose.yml.
# Provide local-only values and never commit the populated .env file.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=DroneBuilderDb
# PostgreSQL installed on the host commonly already uses 5432.
POSTGRES_HOST_PORT=5433

RABBITMQ_USER=
RABBITMQ_PASSWORD=

JWT_ISSUER=
JWT_AUDIENCE=
# Use a cryptographically random value of at least 32 bytes.
JWT_KEY=

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

IDENTITY_ADMIN_EMAIL=
IDENTITY_ADMIN_PASSWORD=
IDENTITY_USER_EMAIL=
IDENTITY_USER_PASSWORD=
