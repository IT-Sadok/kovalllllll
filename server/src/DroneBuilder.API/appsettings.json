{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "DatabaseInitialization": {
    "ApplyMigrations": false,
    "SeedIdentity": false
  },
  "IdentitySeed": {
    "Admin": {
      "Email": "",
      "Password": ""
    },
    "User": {
      "Email": "",
      "Password": ""
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtOptions": {
    "Issuer": "",
    "Audience": "",
    "Key": "",
    "ExpiryMinutes": 60
  },
  "AzureStorage": {
    "ConnectionString": "",
    "ContainerName": "",
    "AccountName": ""
  },
  "Resend": {
    "ApiKey": "",
    "FromEmail": "",
    "ConfirmationUrl": ""
  },
  "Payments": {
    "Provider": "Stripe",
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": "",
      "Currency": "usd",
      "SuccessUrl": "",
      "CancelUrl": ""
    }
  },
  "CartReservation": {
    "TimeToLiveMinutes": 60,
    "SweepIntervalMinutes": 5
  },
  "RabbitMQ": {
    "HostName": "",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/"
  },
  "MessageQueues": {
    "UserQueue": {
      "Name": "user-events-queue",
      "Durable": true,
      "AutoDelete": false,
      "Exclusive": false,
      "MaxRetryCount": 3,
      "PrefetchCount": 10
    },
    "CartQueue": {
      "Name": "cart-events-queue",
      "Durable": true,
      "AutoDelete": false,
      "Exclusive": false,
      "MaxRetryCount": 3,
      "PrefetchCount": 10
    },
    "OrderQueue": {
      "Name": "order-events-queue",
      "Durable": true,
      "AutoDelete": false,
      "Exclusive": false,
      "MaxRetryCount": 5,
      "PrefetchCount": 5
    },
    "ImageQueue": {
      "Name": "image-events-queue",
      "Durable": true,
      "AutoDelete": false,
      "Exclusive": false,
      "MaxRetryCount": 3,
      "PrefetchCount": 20
    },
    "ProductQueue": {
      "Name": "product-events-queue",
      "Durable": true,
      "AutoDelete": false,
      "Exclusive": false,
      "MaxRetryCount": 3,
      "PrefetchCount": 10
    },
    "WarehouseQueue": {
      "Name": "warehouse-events-queue",
      "Durable": true,
      "AutoDelete": false,
      "Exclusive": false,
      "MaxRetryCount": 3,
      "PrefetchCount": 10
    }
  },
  "RaceDayQuadsImport": {
    "BaseUrl": "https://www.racedayquads.com/",
    "MaxProductsPerCategory": 20,
    "MaxVariantsPerProduct": 6,
    "RequestDelayMs": 1000
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 20,
      "WindowInMinutes": 15
    },
    "Email": {
      "PermitLimit": 5,
      "WindowInMinutes": 15
    }
  }
}
