# Copy this file to .env and provide local-only values.
# Never commit the populated .env file.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=DroneBuilderDb

RABBITMQ_USER=
RABBITMQ_PASSWORD=

JWT_ISSUER=
JWT_AUDIENCE=
JWT_KEY=
JWT_EXPIRY_MINUTES=60

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_CONFIRMATION_URL=

# Stripe or Fake. Fake marks orders paid without charging and must never run in production.
PAYMENT_PROVIDER=Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=http://localhost:8080/orders?payment=success
STRIPE_CANCEL_URL=http://localhost:8080/orders?payment=cancelled

IDENTITY_ADMIN_EMAIL=
IDENTITY_ADMIN_PASSWORD=
IDENTITY_USER_EMAIL=
IDENTITY_USER_PASSWORD=
